# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Caches
.cache/
hf_cache/
__marimo__/

# Data: the course-provided files live in provided/ (kept out of git because of size),
# downloaded evaluation sets and paraphrase caches are reproducible via the scripts
data/
provided/*.json

# Model checkpoints
weights/

# Slurm logs (scripts/job.sbatch writes logs/slurm/<job>-<id>.out)
logs/

# Run artefacts: keep the small JSON summaries that the report is built from, drop logs and large dumps
runs/*
!runs/*/
runs/*/*
!runs/*/config.json
!runs/*/history.json
!runs/*/train_summary.json
!runs/*/val_history.json
!runs/*/reranker_summary.json
!runs/*/eval_*/
runs/*/eval_*/*
!runs/*/eval_*/results.json
!runs/*/eval_*/official_eval*.json
# reranker-ablation outputs (scripts/run_reranker_variants.sh): summaries and official-scorer results only
!runs/*/reranker_summary_*.json
!runs/*/rerank_variants/
runs/*/rerank_variants/*
!runs/*/rerank_variants/summary_*.md
!runs/*/rerank_variants/*/
runs/*/rerank_variants/*/*
!runs/*/rerank_variants/*/eval_*/
runs/*/rerank_variants/*/eval_*/*
!runs/*/rerank_variants/*/eval_*/results.json
!runs/*/rerank_variants/*/eval_*/official_eval*.json
# smoke-test runs are never committed (this rule must come after the re-includes above)
runs/smoke*/

# LaTeX build files
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Scratch
scratch*/
